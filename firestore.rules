rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/chats/{chatId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['title','messages','createdAt','updatedAt'])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 200;
    }
    match /users/{uid}/wallpapers/{imageId} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['name','url','path','contentType','size','createdAt'])
        && request.resource.data.size <= 8388608
        && request.resource.data.contentType in ['image/png','image/jpeg','image/webp'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}